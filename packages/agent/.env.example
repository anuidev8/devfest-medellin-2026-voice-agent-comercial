# Copy to .env and fill. Without auth the server runs in demo-no-key mode
# (same NoShy + commercial tool events, scripted replies) so the UI demo still works.
#
# Agent: noshy_concierge (pre-context → match → action plan).
# AG-UI may send state.preContext { persona, building, lookingFor, offering, ... }.
#
# Option A — Vertex AI (what aiops-prime-copilot uses, ADC auth):
#   gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex AI Agent Engine that stores session history (numeric id only).
# Console: https://console.cloud.google.com/vertex-ai/agents/agent-engines
# GOOGLE_CLOUD_AGENT_ENGINE_ID=
#
# Option B — Gemini API key (set GOOGLE_GENAI_USE_VERTEXAI=false above):
# GOOGLE_GENAI_API_KEY=
#
ADK_MODEL=gemini-2.5-flash
# ADK web mic / run_live (adk web) — separate from packages/livekit voice worker
ADK_LIVE_MODEL=gemini-live-2.5-flash-native-audio
ADK_VOICE_LANGUAGE=es-US
PORT=8000

# Proposal email (Resend). Without both values, nothing is sent and the agent says so.
# RESEND_API_KEY=
# EMAIL_FROM=NoShy <propuestas@your-verified-domain.com>
# Seller who receives the brief when a meeting is booked.
# SELLER_EMAIL=
# Lead storage. Defaults to packages/agent/data/deals.json.
# DEALS_FILE=

# Google Meet transcripts + Calendar booking (same OAuth tokens).
# Scopes: meetings.space.readonly + calendar.events
#   packages/agent/.meet-oauth.client.json  { "client_id", "client_secret" }
#   npm run auth:meet -w @commercial/agent   → .meet-oauth.tokens.json
# Enable APIs: Meet API + Google Calendar API
# GOOGLE_CALENDAR_TIMEZONE=America/Bogota
# GOOGLE_MEET_ACCESS_TOKEN=
# GOOGLE_MEET_USE_ADC=false
