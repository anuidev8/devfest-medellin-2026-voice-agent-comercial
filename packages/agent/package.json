{
  "name": "@commercial/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/agent.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "adk:web": "GOOGLE_CLOUD_LOCATION=${GOOGLE_CLOUD_AGENT_ENGINE_LOCATION:-us-west1} adk web -p 8100 --session_service_uri vertexai:// src/agent.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:tools": "tsx src/test-tools.ts",
    "auth:meet": "tsx src/auth-meet.ts"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.3",
    "@google/adk": "^2.3.0",
    "@google/genai": "^2.30.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.9.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@google/adk-devtools": "^2.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
